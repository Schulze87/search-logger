{
    "name": "swag/search-logger",
    "description": "Protokolliert Suchanfragen und Trefferzahlen in Shopware 6.",
    "version": "1.0.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Dein Name"
        }
    ],
    "require": {
        "shopware/core": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "Swag\\SearchLogger\\SwagSearchLogger",
        "label": {
            "de-DE": "Suchanfragen-Protokollierung",
            "en-GB": "Search Query Logger"
        },
        "description": {
            "de-DE": "Speichert Suchbegriffe und Trefferzahlen.",
            "en-GB": "Stores search terms and result counts."
        }
    },
    "autoload": {
        "psr-4": {
            "Swag\\SearchLogger\\": "src/"
        }
    }
}
