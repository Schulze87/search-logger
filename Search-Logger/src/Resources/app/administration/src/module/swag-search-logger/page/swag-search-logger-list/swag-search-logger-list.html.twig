<sw-page>
    <template #content>
        <sw-card title="Suchanfragen" :isLoading="isLoading">
            <sw-container columns="1fr 1fr 1fr" gap="16px">
                <sw-text-field
                    v-model="searchTerm"
                    label="Nach Suchbegriff filtern"
                    placeholder="z. B. Bewässerungsmatte"
                    @update:modelValue="onSearchTermChange"
                />

                <sw-datepicker
                    v-model="dateFrom"
                    label="Von"
                    dateType="date"
                    @update:modelValue="onFilterChange"
                />

                <sw-datepicker
                    v-model="dateTo"
                    label="Bis"
                    dateType="date"
                    @update:modelValue="onFilterChange"
                />
            </sw-container>

            <sw-container columns="1fr 1fr 1fr" gap="16px">
                <sw-single-select
                    :value="salesChannelId"
                    label="Verkaufskanal"
                    :options="salesChannelSelectOptions"
                    :clearable="true"
                    placeholder="Alle Verkaufskanäle"
                    @update:value="onSalesChannelChange"
                />

                <sw-single-select
                    :value="languageId"
                    label="Sprache"
                    :options="languageSelectOptions"
                    :clearable="true"
                    placeholder="Alle Sprachen"
                    @update:value="onLanguageChange"
                />

                <sw-switch-field
                    v-model="onlyZeroResults"
                    label="Nur ohne Ergebnisse"
                />
            </sw-container>

            <sw-container columns="1fr 1fr" gap="16px">
                <sw-button @click="resetFilters">
                    Filter zurücksetzen
                </sw-button>

                <sw-button
                    variant="danger"
                    :disabled="selectedCount === 0"
                    @click="onBulkDelete"
                >
                    Ausgewählte löschen ({{ selectedCount }})
                </sw-button>
            </sw-container>

            <sw-data-grid
                v-if="items.length > 0"
                :dataSource="items"
                :columns="[
                    { property: 'term', label: 'Suchbegriff', allowResize: true, sortable: true },
                    { property: 'search_count', label: 'Anzahl Suchen', allowResize: true, sortable: true },
                    { property: 'result_count', label: 'Treffer', allowResize: true, sortable: true },
                    { property: 'sales_channel_name', label: 'Verkaufskanal', allowResize: true },
                    { property: 'language_name', label: 'Sprache', allowResize: true },
                    { property: 'last_searched', label: 'Zuletzt gesucht', allowResize: true, sortable: true }
                ]"
                identifier="id"
                :showSelection="true"
                :sortBy="sortBy"
                :sortDirection="sortDirection"
                @column-sort="onSort"
                @selection-change="onSelectionChange"
            >
                <template #actions="{ item }">
                    <sw-context-menu-item
                        variant="danger"
                        @click="onDelete(item.term)"
                    >
                        Löschen
                    </sw-context-menu-item>
                </template>
            </sw-data-grid>
            <p v-else>Keine Suchanfragen vorhanden.</p>
        </sw-card>

        <sw-modal
            v-if="showDeleteModal"
            title="Suchbegriff löschen"
            variant="small"
            @modal-close="onCloseDeleteModal"
        >
            <p>
                Alle Einträge für <strong>"{{ termToDelete }}"</strong> werden unwiderruflich gelöscht.
                Fortfahren?
            </p>

            <template #modal-footer>
                <sw-button size="small" @click="onCloseDeleteModal">
                    Abbrechen
                </sw-button>
                <sw-button
                    variant="danger"
                    size="small"
                    @click="onConfirmDelete"
                >
                    Löschen
                </sw-button>
            </template>
        </sw-modal>

        <sw-modal
            v-if="showBulkDeleteModal"
            title="Mehrere Suchbegriffe löschen"
            variant="small"
            @modal-close="onCloseBulkDeleteModal"
        >
            <p>
                <strong>{{ selectedCount }}</strong> Begriff(e) werden unwiderruflich gelöscht.
                Fortfahren?
            </p>

            <template #modal-footer>
                <sw-button size="small" @click="onCloseBulkDeleteModal">
                    Abbrechen
                </sw-button>
                <sw-button
                    variant="danger"
                    size="small"
                    @click="onConfirmBulkDelete"
                >
                    Löschen
                </sw-button>
            </template>
        </sw-modal>
    </template>
</sw-page>
