<sw-page>
    <template #content>
        <sw-card title="Suchanfragen" :isLoading="isLoading">
            <sw-container columns="1fr 1fr 1fr" gap="16px">
                <sw-text-field
                    v-model="searchTerm"
                    label="Nach Suchbegriff filtern"
                    placeholder="z. B. Bewässerungsmatte"
                    @update:modelValue="onSearchTermChange"
                />

                <sw-datepicker
                    v-model="dateFrom"
                    label="Von"
                    dateType="date"
                    @update:modelValue="onFilterChange"
                />

                <sw-datepicker
                    v-model="dateTo"
                    label="Bis"
                    dateType="date"
                    @update:modelValue="onFilterChange"
                />
            </sw-container>

            <sw-button @click="resetFilters">
                Filter zurücksetzen
            </sw-button>

            <sw-data-grid
                v-if="items.length > 0"
                :dataSource="items"
                :columns="[
                    { property: 'term', label: 'Suchbegriff', allowResize: true, sortable: true },
                    { property: 'search_count', label: 'Anzahl Suchen', allowResize: true, sortable: true },
                    { property: 'result_count', label: 'Treffer', allowResize: true, sortable: true },
                    { property: 'last_searched', label: 'Zuletzt gesucht', allowResize: true, sortable: true }
                ]"
                :showSelection="false"
                :sortBy="sortBy"
                :sortDirection="sortDirection"
                @column-sort="onSort"
            />
            <p v-else>Keine Suchanfragen vorhanden.</p>
        </sw-card>
    </template>
</sw-page>
